<?php
require_once __DIR__ . '/../config/config.php';
require_once __DIR__ . '/../includes/security.php';
require_admin();
if ($_SESSION['admin_role'] !== 'admin') { die('Access denied'); }

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $id = (int)($_POST['id'] ?? 0);
    $u = clean_input($_POST['username'] ?? '');
    $e = clean_input($_POST['email'] ?? '');
    $n = clean_input($_POST['full_name'] ?? '');
    $r = $_POST['role'] ?? 'editor';
    $p = $_POST['password'] ?? '';
    if ($id) {
        if ($p) db()->prepare("UPDATE users SET username=?, email=?, full_name=?, role=?, password_hash=? WHERE id=?")->execute([$u,$e,$n,$r,password_hash($p, PASSWORD_DEFAULT),$id]);
        else db()->prepare("UPDATE users SET username=?, email=?, full_name=?, role=? WHERE id=?")->execute([$u,$e,$n,$r,$id]);
    } else {
        db()->prepare("INSERT INTO users (username, email, full_name, role, password_hash) VALUES (?,?,?,?,?)")
            ->execute([$u,$e,$n,$r,password_hash($p ?: 'ChangeMe123', PASSWORD_DEFAULT)]);
    }
    redirect(BASE_URL . 'admin/users.php');
}
$users = db()->query("SELECT * FROM users ORDER BY id")->fetchAll();
?>
